{
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "../../.tsbuildinfo/core.tsbuildinfo",

    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "types",
    "target": "ES2020",
    "module": "Node16",
    "lib": ["ES2020"],
    "downlevelIteration": true,
    "rootDir": "src",
    "declarationMap": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@flow-scanner/regex-scanner": ["../regex-scanner/out"],
      "@flow-scanner/regex-scanner/*": ["../regex-scanner/out/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "out"],
  "references": [
    { "path": "../regex-scanner" }
  ]
}
