{
  "name": "@flow-scanner/regex-scanner",
  "description": "Generic regex-based scanning engine.",
  "version": "1.1.0",
  "main": "out/index.js",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "import": "./out/index.js",
      "require": "./out/index.js",
      "default": "./out/index.js"
    }
  },
  "engines": {
    "node": "^18 || ^20 || ^22 || ^23 || ^24"
  },
  "scripts": {
    "clean": "rimraf out",
    "build:js": "swc src --out-dir out --copy-files --strip-leading-paths --config-file .swcrc",
    "build:types": "tsc -p tsconfig.types.json --declaration --emitDeclarationOnly --outDir out",
    "build": "npm run clean && npm run build:js && npm run build:types",
    "test": "jest --passWithNoTests",
    "version:patch": "pnpm version patch --no-git-tag-version",
    "version:minor": "pnpm version minor --no-git-tag-version",
    "version:major": "pnpm version major --no-git-tag-version",
    "prepare:publish": "node scripts/prepare-publish.js",
    "publish:npm": "npm run build && npm run prepare:publish && cd out && npm publish --access public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Flow-Scanner/lightning-flow-scanner.git",
    "directory": "packages/regex-scanner"
  },
  "devDependencies": {
    "@swc/cli": "0.7.7",
    "@swc/core": "1.13.5",
    "@types/jest": "29.5.14",
    "@types/node": "22.15.30",
    "jest": "30.0.3",
    "rimraf": "^6.1.0",
    "typescript": "5.8.3"
  },
  "author": {
    "name": "Ruben Halman",
    "url": "https://github.com/RubenHalman"
  },
  "keywords": [
    "regex",
    "scanner",
    "salesforce",
    "metadata",
    "linter",
    "static-analysis"
  ]
}
